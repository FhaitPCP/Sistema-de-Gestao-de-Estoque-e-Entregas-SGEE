@startuml
!define RECTANGLE class
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 40

node "Dispositivo do Utilizador" as Client {
    [Navegador Web / App Mobile] as UI
}

node "Infraestrutura Docker (Ambiente SGEE)" as DockerInfra {
    
    node "Contêiner Front-end" as FrontCont {
        component "Aplicação Cliente\n(Node.js / Framework UI)" as NodeApp
    }
    
    node "Contêineres Back-end (Java / Spring Boot)" as BackCont {
        component "API Gateway & Segurança\n(Spring Cloud + Spring Security)" as ApiGateway
        
        component "Microsserviço de Estoque\n(Gestão de Produtos e Saldos)" as MSEstoque
        component "Microsserviço de Faturação\n(Vendas, Custos e Notas Fiscais)" as MSFaturacao
        component "Microsserviço de Entregas\n(Logística e Comprovativos)" as MSEntregas
    }
    
    node "Contêineres de Dados (SQL)" as DbCont {
        database "Base de Dados\nEstoque (SQL)" as DBEstoque
        database "Base de Dados\nFaturação (SQL)" as DBFaturacao
        database "Base de Dados\nEntregas (SQL)" as DBEntregas
    }
}

' Comunicação Externa
UI --> NodeApp : "HTTPS"
NodeApp --> ApiGateway : "HTTPS / REST (JSON)"

' Roteamento Interno no Docker Network
ApiGateway --> MSEstoque : "Roteamento Interno"
ApiGateway --> MSFaturacao : "Roteamento Interno"
ApiGateway --> MSEntregas : "Roteamento Interno"

' Persistência de Dados
MSEstoque --> DBEstoque : "JDBC / JPA"
MSFaturacao --> DBFaturacao : "JDBC / JPA"
MSEntregas --> DBEntregas : "JDBC / JPA"

' Comunicação Inter-serviços (Assíncrona para evitar acoplamento)
MSEstoque .right.> MSFaturacao 
MSFaturacao .right.> MSEntregas

@enduml